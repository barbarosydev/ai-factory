{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(task)",
      "Bash(task --list)",
      "Bash(task build*)",
      "Bash(task doctor*)",
      "Bash(task status*)",
      "Bash(task lint*)",
      "Bash(task test*)",
      "Bash(task ci*)",
      "Bash(task eval*)",
      "Bash(go test*)",
      "Bash(go vet*)",
      "Bash(go tool workflowcheck*)",
      "Bash(golangci-lint*)",
      "Bash(temporal operator cluster health*)",
      "Bash(temporal workflow list*)",
      "Bash(temporal workflow describe*)",
      "Bash(temporal workflow show*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(tests/hooks/run.sh)",
      "Bash(mise ls*)",
      "Bash(mise --version)"
    ],
    "ask": [
      "Bash(task run*)",
      "Bash(task clean:failed*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.kube/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/keychain-kube-guard.py" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/branch-guard.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-guard.sh" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gofmt.sh" }
        ]
      }
    ]
  }
}
